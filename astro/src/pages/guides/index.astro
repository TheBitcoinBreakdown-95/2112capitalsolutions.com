---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { courses } from '../../data/courses';

const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const sorted = allGuides.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const publishedCourses = courses.filter((c) => !c.draft);

// A series is a hub guide plus every guide whose id extends the hub's id.
const SERIES_HUB = 'coldcard-seed-flaw';
const seriesHub = sorted.find((g) => g.id === SERIES_HUB);
const seriesParts = sorted
  .filter((g) => g.id.startsWith(`${SERIES_HUB}-`))
  .sort((a, b) => a.id.localeCompare(b.id));
const seriesIds = new Set([SERIES_HUB, ...seriesParts.map((g) => g.id)]);
const standalone = sorted.filter((g) => !seriesIds.has(g.id));

// Keep whichever half of the title actually distinguishes the page.
const shortTitle = (t: string) => {
  const SUFFIX = ': what to do about the seed flaw';
  if (t.toLowerCase().endsWith(SUFFIX)) return t.slice(0, -SUFFIX.length);
  const i = t.indexOf(': ');
  if (i === -1) return t;
  const tail = t.slice(i + 2);
  return tail.charAt(0).toUpperCase() + tail.slice(1);
};

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).toUpperCase();
---
<BaseLayout
  title="Guides &amp; Courses — 2112 Capital Solutions"
  description="Documented procedures and full courses from real client engagements. Bitcoin custody, AI workflow, privacy, self-hosted infrastructure. Source-linked, no fluff."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="classify">MODULE 04 — GUIDES &amp; COURSES · DOCUMENTED PROCEDURES</div>
      <h1>Field guides. <em>Procedures we ship.</em></h1>
      <div class="hero-sub">
        Documented procedures and full courses · Bitcoin · AI · Privacy · Self-hosting · Source-linked, traceable, free
      </div>
    </div>
  </section>

  {publishedCourses.length > 0 && (
    <section class="module">
      <div class="container">
        <div class="module-classify">
          <span>COURSES</span>
          <span class="ref">{publishedCourses.length} {publishedCourses.length === 1 ? 'COURSE' : 'COURSES'}</span>
        </div>

        <div class="card-grid">
          {publishedCourses.map((course) => (
            <a href={`/courses/${course.slug}/`} class="card">
              <div class="card-eyebrow">
                COURSE · {course.estimatedTime.toUpperCase()}
              </div>
              <div class="card-title">{course.title}</div>
              <p class="card-excerpt">{course.tagline}</p>
              <div class="card-meta">
                <span>{course.chapterCount} CHAPTERS</span>
                <span>{course.level.toUpperCase()}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- GUIDES GRID -->
  <section class="module">
    <div class="container">
      <div class="module-classify">
        <span>ALL GUIDES</span>
        <span class="ref">{sorted.length} {sorted.length === 1 ? 'ENTRY' : 'ENTRIES'}</span>
      </div>

      {sorted.length === 0 ? (
        <p class="module-lede">No guides published yet. Check back shortly.</p>
      ) : (
        <div class="card-grid">
          {seriesHub && (
            <a href={`/guides/${seriesHub.id}`} class="card card--featured">
              <div class="card-eyebrow">
                {seriesHub.data.category.toUpperCase()} · LIVE ADVISORY
                {seriesHub.data.readingTime ? ` · ${seriesHub.data.readingTime.toUpperCase()}` : ''}
              </div>
              <div class="card-title">{seriesHub.data.title}</div>
              <p class="card-excerpt">{seriesHub.data.description}</p>
              <div class="card-meta">
                <span>{fmt(seriesHub.data.pubDate)}</span>
                <span>{seriesHub.data.level.toUpperCase()}</span>
              </div>
              {seriesParts.length > 0 && (
                <div class="series-list">
                  <div class="series-list-label">Supporting detail</div>
                  {seriesParts.map((part, i) => (
                    <span class="series-item">
                      <span class="series-item-num">{String(i + 1).padStart(2, '0')}</span>
                      <span class="series-item-title">{shortTitle(part.data.title)}</span>
                      {part.data.readingTime && <span class="series-item-meta">{part.data.readingTime}</span>}
                    </span>
                  ))}
                </div>
              )}
            </a>
          )}

          {standalone.map((guide) => (
            <a href={`/guides/${guide.id}`} class="card">
              <div class="card-eyebrow">
                {guide.data.category.toUpperCase()}
                {guide.data.readingTime ? ` · ${guide.data.readingTime.toUpperCase()}` : ''}
              </div>
              <div class="card-title">{guide.data.title}</div>
              <p class="card-excerpt">{guide.data.description}</p>
              <div class="card-meta">
                <span>{fmt(guide.data.pubDate)}</span>
                <span>{guide.data.level.toUpperCase()}</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
